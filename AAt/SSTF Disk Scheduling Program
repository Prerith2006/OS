#include <stdio.h>
#include <stdlib.h>

int main() {
    int queue[20], visited[20] = {0};
    int n, head, i, totalSeek = 0;

    printf("SSTF Disk Scheduling\n");

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &queue[i]);
    }

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("\nSeek Sequence:\n");

    for(i = 0; i < n; i++) {

        int min = 9999;
        int index = -1;
        int j;

        for(j = 0; j < n; j++) {

            if(!visited[j]) {

                int distance = abs(queue[j] - head);

                if(distance < min) {
                    min = distance;
                    index = j;
                }
            }
        }

        visited[index] = 1;
        totalSeek += min;
        head = queue[index];

        printf("%d -> ", head);
    }

    printf("\n\nTotal Seek Time = %d\n", totalSeek);

    return 0;
}

