#include <stdio.h>

int main() {
    int users, files, i, j;
    char user[20][30];
    char filename[20][20][30];

    printf("Two Level Directory\n");

    printf("Enter number of users: ");
    scanf("%d", &users);

    for(i = 0; i < users; i++) {

        printf("\nEnter username: ");
        scanf("%s", user[i]);

        printf("Enter number of files for %s: ", user[i]);
        scanf("%d", &files);

        printf("Enter file names:\n");

        for(j = 0; j < files; j++) {
            scanf("%s", filename[i][j]);
        }
    }

    printf("\nDirectory Structure:\n");

    for(i = 0; i < users; i++) {

        printf("\nUser: %s\n", user[i]);

        for(j = 0; filename[i][j][0] != '\0'; j++) {
            printf("%s\n", filename[i][j]);
        }
    }

    return 0;
}

